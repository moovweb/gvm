#!/usr/bin/env bash
# gvm listall is the old name for gvm ls-remote.
#
# It used to run `git ls-remote -t https://github.com/golang/go`, which needed
# git, hit github.com, and listed tags such as "release-branch.go1.4" that
# were never installable. The go.dev index is authoritative and offline
# cacheable. The --all flag keeps its old meaning of "include pre-releases".
. "$GVM_ROOT/scripts/functions"

if [ "$1" = "-a" ] || [ "$1" = "--all" ]; then
	shift
	exec "$GVM_ROOT/scripts/ls-remote" --all "$@"
fi
exec "$GVM_ROOT/scripts/ls-remote" "$@"
