#!/usr/bin/env bash
#
# `source $GVM_ROOT/scripts/env/cd`
#
# Overrides cd() so that walking into a directory switches the Go version and
# package set, the way .nvmrc and .node-version work for nvm:
#
#   .go-version     go1.24.13, or 1.24, or stable
#   .go-pkgset      the package set to select alongside it
#
# The previous version of this file rebuilt its own `cd` with a
# `declare -f | sed | eval` dance on every source, which lost the user's own cd
# override, and on the second source captured gvm's override as if it were the
# original - so cd() recursed into itself until bash died with a stack
# overflow. It also leaned on __gvm_resolve_fallback_*, which parse
# `gvm list --porcelain` output that no longer exists, so the fallback path
# could only ever return nothing.
#
# This version identifies its own override with a marker in the function body
# instead of function identity, which makes re-sourcing safe in a profile.

. "$GVM_ROOT/scripts/functions" || return 1
. "$GVM_ROOT/scripts/function/_shell_compat" || return 1

GVM_CD_MARKER="gvm:cd-override"

# _gvm_cd_capture_original
# Saves whatever cd() the user already had as __gvm_oldcd, exactly once.
_gvm_cd_capture_original() {
	if __gvm_is_function __gvm_oldcd; then
		return 0
	fi

	if __gvm_is_function cd; then
		# Rename the definition instead of lifting the body out of it. Taking
		# the body meant deleting the first and last line and assuming the
		# braces sit where bash 5 puts them:
		#
		#   cd ()        <- dropped
		#   {            <- kept, and it should not have been
		#       ...
		#   }            <- dropped
		#
		# which evals to unbalanced braces, fails, and leaves __gvm_oldcd
		# undefined. cd() then skips the real cd and silently stops changing
		# directory, in every shell, for anyone who had a cd of their own.
		local declaration renamed=""
		declaration="$(declare -f cd)"
		case "$declaration" in
			'cd ()'*) renamed="__gvm_oldcd ()${declaration#cd ()}" ;;
			'cd()'*) renamed="__gvm_oldcd()${declaration#cd()}" ;;
		esac
		if [ -n "$renamed" ] && eval "$renamed" 2> /dev/null &&
			__gvm_is_function __gvm_oldcd; then
			return 0
		fi
	fi

	# Either cd was the builtin, or the user's function could not be copied.
	eval '__gvm_oldcd() { builtin cd "$@"; return $?; }'
}

_gvm_cd_capture_original

# gvm_cd_use_version <version>
# Switches in the current shell, quietly. Falls back to sourcing the
# environment file when the `gvm` function is not available, so this works in a
# shell that has only sourced the functions and not the wrapper.
gvm_cd_use_version() {
	local wanted="$1"

	if __gvm_is_function gvm; then
		gvm use --quiet "$wanted" > /dev/null 2>&1 && return 0
	fi

	local resolved
	resolved="$(gvm_resolve_version "$wanted" local 2> /dev/null)" || return 1
	[ -n "$resolved" ] || return 1
	[ -f "$GVM_ROOT/environments/$resolved" ] || return 1
	. "$GVM_ROOT/environments/$resolved" > /dev/null 2>&1 || return 1
	gvm_export_path
	local munged
	munged="$(__gvm_munge_path)"
	export PATH="$munged"
	return 0
}

# gvm_cd_use_pkgset <pkgset>
gvm_cd_use_pkgset() {
	local wanted="$1"

	if __gvm_is_function gvm; then
		gvm pkgset use --quiet "$wanted" > /dev/null 2>&1 && return 0
	fi

	[ -d "$GVM_ROOT/pkgsets/${gvm_go_name:-}/$wanted" ] || return 1
	export gvm_pkgset_name="$wanted"
	export GOPATH="$GVM_ROOT/pkgsets/${gvm_go_name}/${wanted}"
	local munged
	munged="$(__gvm_munge_path)"
	export PATH="$munged"
	return 0
}

# gvm_cd_on_change
# The body of cd(), split out so it can be reasoned about (and so the wrapper
# below stays a one-liner).
gvm_cd_on_change() {
	if [ -z "${GVM_ROOT:-}" ]; then
		display_error "GVM_ROOT is not set, so automatic switching is off."
		display_message "Add this to your shell profile:"
		display_message "    [[ -s \"\$HOME/.gvm/scripts/gvm\" ]] && source \"\$HOME/.gvm/scripts/gvm\""
		return 1
	fi

	local version_file pkgset_file
	version_file="$(__gvm_find_path_upwards ".go-version" 2> /dev/null)" || version_file=""
	if [ -n "$version_file" ]; then
		local wanted
		wanted="$(gvm_cd_read_dot_file "$version_file" '^go([0-9][0-9A-Za-z._*+-]*)$|^([0-9][0-9A-Za-z._*+-]*)$')" || wanted=""
		if [ -n "$wanted" ]; then
			gvm_cd_use_version "$wanted" || {
				# A .go-version for something that is not installed is a
				# mistake worth mentioning, but it must not stop the cd.
				gvm_flag_is_set GVM_QUIET || display_warning ".go-version asks for '${wanted}', which is not installed."
			}
		fi
	fi

	pkgset_file="$(__gvm_find_path_upwards ".go-pkgset" 2> /dev/null)" || pkgset_file=""
	if [ -n "$pkgset_file" ]; then
		local wanted_pkgset
		wanted_pkgset="$(gvm_cd_read_dot_file "$pkgset_file" '^[A-Za-z0-9._#:%+-]+$')" || wanted_pkgset=""
		if [ -n "$wanted_pkgset" ] && ! gvm_cd_use_pkgset "$wanted_pkgset"; then
			# Same reasoning as the version: say something, but let the cd
			# through, because failing to switch packages is not a reason to
			# refuse to change directory.
			gvm_flag_is_set GVM_QUIET || display_warning ".go-pkgset asks for '${wanted_pkgset}', which does not exist for ${gvm_go_name:-this version}."
		fi
	fi

	return 0
}

# gvm_cd_read_dot_file <path> <regex>
# Prints the first line of <path> that is not a comment and matches <regex>,
# ignoring blank lines. A .go-version with a comment above it should work.
gvm_cd_read_dot_file() {
	local filepath="$1" regex="$2" line

	[ -r "$filepath" ] || return 1

	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%%#*}"
		# Trim surrounding whitespace.
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		[ -z "$line" ] && continue
		# `case` takes globs, not regular expressions, and writing a regex here
		# silently matched nothing. __gvm_rematch is the one matcher that works
		# the same way in bash and zsh.
		if __gvm_rematch "$line" "$regex"; then
			printf '%s\n' "$line"
			return 0
		fi
	done < "$filepath"

	return 1
}

# cd()
# /*!
# @abstract cd that switches Go version and package set on directory changes.
# @param path Path of directory to change into.
# @return The status of the underlying cd().
# */
# $GVM_CD_MARKER below is what makes re-sourcing this file safe.
cd() { # $GVM_CD_MARKER
	if __gvm_is_function __gvm_oldcd; then
		__gvm_oldcd "$@" || return $?
	fi

	gvm_cd_on_change
}

# Clean up any paths left behind, as `gvm use` does, but only on the first
# source; doing it on every source would rewrite PATH repeatedly.
if [ -z "${GVM_CD_EXPORTED:-}" ]; then
	GVM_CD_EXPORTED=1
	export GVM_CD_EXPORTED
	export PATH="$(__gvm_munge_path)"
fi
