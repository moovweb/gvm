#!/usr/bin/env bash
#
# gvm-default - the payload sourced by the line in scripts/gvm.
#
# Sourced, not executed: this file's whole job is to leave the calling shell
# with a sane environment and a `gvm` function defined.

# A Go inherited from a distro package, another manager, or a Docker image
# will fight with everything below.
unset GOROOT GOPATH GOBIN GOOS GOARCH GOFLAGS GO111MODULE
unset gvm_go_name gvm_pkgset_name gvm_alias_name

GVM_VERSION="$(cat "$GVM_ROOT/VERSION" 2> /dev/null)"
export GVM_VERSION

# Runtime directories.
for dir in logs gos archive cache environments aliases pkgsets; do
	mkdir -p "$GVM_ROOT/$dir" 2> /dev/null
done

# Our bin directory holds bin/gvm, which everything else calls.
case ":$PATH:" in
	*":$GVM_ROOT/bin:"*) ;;
	*) PATH="$GVM_ROOT/bin:$PATH" ;;
esac
export PATH
export GVM_PATH_BACKUP="$PATH"

# A version recorded by `gvm use --default`.
if [ -f "$GVM_ROOT/environments/default" ]; then
	. "$GVM_ROOT/environments/default"
fi

. "$GVM_ROOT/scripts/env/gvm"

# Auto-switching on .go-version / .go-pkgset, and the version already
# selected when the shell starts.
if [ -f "$GVM_ROOT/scripts/env/cd" ]; then
	. "$GVM_ROOT/scripts/env/cd"
	cd . 2> /dev/null
fi
