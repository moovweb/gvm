#!/usr/bin/env bash
#
# gvm install
#
# Historically this cloned the entire golang/go repository with git, which
# costs well over a gigabyte of history and minutes of wall clock just to
# obtain a ~30MB source tarball that go.dev already publishes. Both the
# binary and the source path now come from the official artifacts, verified
# against the SHA256 in the release index, and nothing is cloned unless you
# explicitly ask for a git checkout with --from-git.

. "$GVM_ROOT/scripts/functions"

INSTALL_METHOD="prefer-binary"
GO_NAME=""
GO_VERSION=""
GIT_SOURCE_URL="https://github.com/golang/go"
GIT_REF=""
BUILT_VERSION=""
FORCE=""
SET_DEFAULT=""
NO_CACHE=""
REQUESTED=""

# Progress and diagnostics go to stderr, for the whole installer.
#
# This script captures the output of helpers such as fetch_artifact with
# "$(...)", and the display functions defined in scripts/function write to
# stdout. A "Downloading go1.27.1.linux-amd64.tar.gz" line would therefore end
# up inside the path that fetch_artifact is supposed to return, and every
# install would fail in tar. Only real data may go to stdout, so the display
# functions are shadowed here; every other command keeps the old convention.
function display_message() {
	if command -v tput &> /dev/null && [[ "$TERM" == "xterm" ]]; then
		tput sgr0
		tput setaf 2
		printf '%s\n' "$*" >&2
		tput sgr0
	else
		printf '%s\n' "$*" >&2
	fi
}

function display_error() {
	if command -v tput &> /dev/null && [[ "$TERM" == "xterm" ]]; then
		tput sgr0
		tput setaf 1
		printf '%s\n' "$*" >&2
		tput sgr0
	else
		printf '%s\n' "$*" >&2
	fi
}

function display_warning() {
	if command -v tput &> /dev/null && [[ "$TERM" == "xterm" ]]; then
		tput sgr0
		tput setaf 3
		printf '%s\n' "$*" >&2
		tput sgr0
	else
		printf '%s\n' "$*" >&2
	fi
}

function show_usage() {
	cat <<'EOF'
Usage: gvm install [<version>] [options]

  Installs Go from the official go.dev artifacts. <version> accepts a full
  version (go1.24.13), a partial one (1.24 -> the newest go1.24.x), a glob
  (1.24.*), or an alias (stable). Defaults to the newest stable release.

Source options:
  -b, --binary           Only install a prebuilt binary. Default.
  -s, --source           Build from the official source tarball.
      --prefer-binary    Try a binary, fall back to source. Default.
      --prefer-source    Try a source build, fall back to a binary.
      --from-git         Clone golang/go and build <ref> from the checkout.
                         Also accepts "master" / "tip" for unreleased trees.

Other options:
  -n, --name <name>      Install under a different name, e.g. "work".
      --force            Reinstall even if the version is already installed.
      --no-set-default   Do not make this the default version afterwards.
      --no-cache         Ignore the cached release index.
      --verbose          Show compiler output while building from source.
  -h, --help             Show this message.

Examples:
  gvm install                        newest stable release
  gvm install 1.24                   newest go1.24.x
  gvm install go1.24.13              an exact release
  gvm install stable                 the newest stable release
  gvm install 1.27 --source          build it yourself
  gvm install master --from-git      build the development tree
EOF
}

function read_command_line() {
	while [ $# -gt 0 ]; do
		case "$1" in
			-b | --binary) INSTALL_METHOD="binary" ;;
			-s | --source) INSTALL_METHOD="source" ;;
			--prefer-binary) INSTALL_METHOD="prefer-binary" ;;
			--prefer-source) INSTALL_METHOD="prefer-source" ;;
			--from-git) INSTALL_METHOD="git" ;;
			-n | --name)
				shift
				[ $# -gt 0 ] || {
					display_error "$1 requires a name"
					exit 65
				}
				GO_NAME="$1"
				;;
			-n=* | --name=*) GO_NAME="${1#*=}" ;;
			--force) FORCE=1 ;;
			--no-set-default) SET_DEFAULT="" ;;
			--set-default) SET_DEFAULT=1 ;;
			--no-cache) NO_CACHE=1 ;;
			--verbose) VERBOSE=1 ;;
			--source-url=*) GIT_SOURCE_URL="${1#*=}" ;;
			-h | --help)
				show_usage
				exit 0
				;;
			-*)
				display_warning "Invalid option: $1"
				show_usage
				exit 65
				;;
			*)
				[ -n "$GO_VERSION" ] && {
					display_warning "Only one version may be given"
					exit 65
				}
				GO_VERSION="$1"
				;;
		esac
		shift
	done

	[ -n "$NO_CACHE" ] && GVM_INDEX_TTL=0

	# A git checkout is built from whatever ref was named; there is no
	# published version to resolve it against.
	if [ "$INSTALL_METHOD" = "git" ]; then
		GIT_REF="$GO_VERSION"
		[ -n "$GIT_REF" ] || GIT_REF="master"
		[ -n "$GO_NAME" ] || GO_NAME="$GIT_REF"
		GO_VERSION=""
		return 0
	fi

	[ -n "$GO_VERSION" ] || GO_VERSION="stable"
}

# Where a downloaded artifact is kept between installs.
function artifact_path() {
	echo "$GVM_ROOT/cache/downloads/${1:-}"
}

# fetch_artifact <version> <os> <arch> <archive|source>
# Downloads (or reuses) the official tarball and verifies its SHA256.
# Echoes the local path on success.
function fetch_artifact() {
	local version="${1:-}" os="${2:-}" arch="${3:-}" kind="${4:-archive}"
	local info filename size sha dest

	info="$(gvm_index_file_for "$version" "$os" "$arch" "$kind")"
	if [ -z "$info" ]; then
		return 1
	fi
	# shellcheck disable=SC2086
	set -- $info
	filename="${1:-}"
	size="${2:-}"
	sha="${3:-}"

	if [ -z "$filename" ]; then
		return 1
	fi

	dest="$(artifact_path "$filename")"
	if [ -f "$dest" ]; then
		# A cached file is only reused if it still matches, so an
		# interrupted download can never poison later installs.
		if gvm_verify_checksum "$dest" "$sha" "$filename" 2> /dev/null; then
			echo "$dest"
			return 0
		fi
		rm -f "$dest"
	fi

	display_message "Downloading $filename"
	if [ -n "$size" ] && [ "$size" != "0" ] && ! gvm_flag_is_set GVM_QUIET && [ -t 2 ]; then
		display_message "  $(gvm_human_size "$size")"
	fi

	if ! gvm_download "$GVM_DL_BASE_URL/$filename" "$dest"; then
		display_error "Failed to download $filename"
		display_message "If you are behind a proxy, export http_proxy/https_proxy and retry."
		rm -f "$dest"
		return 1
	fi

	if ! gvm_verify_checksum "$dest" "$sha" "$filename"; then
		rm -f "$dest"
		return 1
	fi

	echo "$dest"
}

function gvm_human_size() {
	local bytes="${1:-0}"
	if [ "$bytes" -ge 1048576 ] 2> /dev/null; then
		echo "$((bytes / 1048576))MB"
	elif [ "$bytes" -ge 1024 ] 2> /dev/null; then
		echo "$((bytes / 1024))KB"
	else
		echo "${bytes}B"
	fi
}

# Both official tarballs unpack into a single top-level `go/` directory, so one
# strip is correct for every release from go1.0 onwards.
function extract_artifact() {
	local archive="${1:-}" dest="${2:-}"
	[ -f "$archive" ] || return 1
	mkdir -p "$dest" || return 1

	if ! tar -xzf "$archive" -C "$dest" --strip-components 1; then
		display_error "Failed to extract $(basename -- "$archive")"
		return 1
	fi

	# Guard against an archive that unpacked into something unexpected.
	if [ ! -x "$dest/bin/go" ] && [ ! -d "$dest/src" ]; then
		display_error "$(basename -- "$archive") did not contain a Go tree"
		return 1
	fi
	return 0
}

# install_from_binary
function install_from_binary() {
	local os arch tarball tarball_path

	if ! os="$(gvm_platform_os)" || [ -z "$os" ]; then
		display_error "Unrecognised operating system: $(uname -s)"
		display_message "Go publishes no binaries for it; use --source instead."
		return 2
	fi
	if ! arch="$(gvm_platform_arch)" || [ -z "$arch" ]; then
		display_error "Unrecognised architecture: $(uname -m)"
		display_message "Go publishes no binaries for it; use --source instead."
		return 2
	fi

	tarball_path="$(fetch_artifact "$GO_VERSION" "$os" "$arch" archive)" || {
		display_error "No $os/$arch binary is published for $GO_VERSION"
		local available
		available="$(gvm_index_platforms "$GO_VERSION")"
		if [ -n "$available" ]; then
			display_message "Published platforms: $available"
		fi
		return 2
	}

	extract_artifact "$tarball_path" "$GO_INSTALL_ROOT" || return 1
	return 0
}

# install_from_source
function install_from_source() {
	local tarball_path bootstrap log

	log="$GVM_ROOT/logs/go-$GO_NAME-compile.log"
	mkdir -p "$GVM_ROOT/logs"

	# Resolve the bootstrap toolchain *before* the tarball is unpacked. The
	# source tree ships its own VERSION file, so an already-extracted
	# $GVM_ROOT/gos/$GO_NAME looks exactly like a usable Go tree and gets
	# nominated to build itself, which make.bash then refuses.
	if ! bootstrap="$(gvm_bootstrap_resolve "$GO_VERSION")"; then
		rm -rf "$GO_INSTALL_ROOT"
		return 2
	fi

	tarball_path="$(fetch_artifact "$GO_VERSION" "" "" source)" || {
		display_error "No source tarball is published for $GO_VERSION"
		rm -rf "$GO_INSTALL_ROOT"
		return 2
	}

	extract_artifact "$tarball_path" "$GO_INSTALL_ROOT" || return 1

	local make_script
	case "$(uname -s)" in
		MINGW* | MSYS* | CYGWIN*) make_script="make.bat" ;;
		*) make_script="make.bash" ;;
	esac

	if [ ! -f "$GO_INSTALL_ROOT/src/$make_script" ]; then
		display_error "$GO_VERSION has no src/$make_script, so it cannot be built from source here"
		display_message "Try 'gvm install $GO_VERSION --binary' instead."
		rm -rf "$GO_INSTALL_ROOT"
		return 2
	fi

	if [ -n "$bootstrap" ]; then
		display_message "Bootstrapping with $(gvm_go_version_of "$bootstrap") ($bootstrap)"
		export GOROOT_BOOTSTRAP="$bootstrap"
	else
		display_message "Bootstrapping from C (no Go toolchain needed)"
		unset GOROOT_BOOTSTRAP
	fi

	display_message "Building $GO_VERSION from source (log: $log)"

	# make.bash derives GOROOT from its own location and refuses to run when
	# GOROOT_BOOTSTRAP == GOROOT, so neither is set here. GOOS/GOARCH/GOPATH
	# are cleared so the build is host-native and reproducible regardless of
	# the invoking shell's environment.
	(
		unset GOROOT GOPATH GOBIN GOOS GOARCH GOFLAGS GO111MODULE
		# Keep the bootstrap from trying to fetch an even newer toolchain
		# over the network halfway through the build.
		export GOTOOLCHAIN=local
		cd "$GO_INSTALL_ROOT/src" || exit 1
		chmod -f +x "./$make_script"
		if [ -n "$VERBOSE" ]; then
			"./$make_script" -v 2>&1 | tee "$log"
			exit "${PIPESTATUS[0]}"
		fi
		"./$make_script" > "$log" 2>&1
	) || {
		display_error "Failed to build $GO_VERSION from source"
		display_message "See $log for the last output."
		return 1
	}

	if [ ! -x "$GO_INSTALL_ROOT/bin/go" ]; then
		display_error "The build finished but produced no $GO_INSTALL_ROOT/bin/go"
		display_message "See $log"
		return 1
	fi
	return 0
}

# install_from_git
# Kept for development trees and for tags that were never published as a
# tarball. This is the only path that clones the Go repository.
function install_from_git() {
	local log="$GVM_ROOT/logs/go-$GO_NAME-git.log"
	mkdir -p "$GVM_ROOT/logs" "$GVM_ROOT/cache"

	# Go's repository is over a gigabyte of history and none of it is needed to
	# build one ref, so ask for a shallow clone of exactly that ref first. Only
	# fall back to the full history if the ref is not a branch or tag, which is
	# what a raw commit id looks like.
	display_message "Cloning $GIT_SOURCE_URL at $GIT_REF (shallow)"
	if ! git clone --quiet --depth 1 --single-branch --branch "$GIT_REF" \
		"$GIT_SOURCE_URL" "$GO_INSTALL_ROOT" > "$log" 2>&1; then
		display_message "'$GIT_REF' is not a branch or tag; cloning the full history instead"
		rm -rf "$GO_INSTALL_ROOT"
		if ! git clone --quiet --filter=blob:none "$GIT_SOURCE_URL" "$GO_INSTALL_ROOT" >> "$log" 2>&1; then
			display_error "Failed to clone $GIT_SOURCE_URL"
			display_message "See $log"
			return 1
		fi
	fi

	if ! (cd "$GO_INSTALL_ROOT" && git checkout --quiet "$GIT_REF") >> "$log" 2>&1; then
		display_error "No such ref: $GIT_REF"
		rm -rf "$GO_INSTALL_ROOT"
		return 2
	fi

	# "master" is not a version number, so ask the checkout what it is going to
	# become and pick a bootstrap from that.
	local build_version
	build_version="$(gvm_bootstrap_checkout_version "$GO_INSTALL_ROOT")" ||
		build_version="$GIT_REF"
	[ -n "$build_version" ] || build_version="$GIT_REF"

	local bootstrap
	if ! bootstrap="$(gvm_bootstrap_resolve "$build_version")"; then
		rm -rf "$GO_INSTALL_ROOT"
		return 2
	fi

	local make_script
	case "$(uname -s)" in
		MINGW* | MSYS* | CYGWIN*) make_script="make.bat" ;;
		*) make_script="make.bash" ;;
	esac

	[ -f "$GO_INSTALL_ROOT/src/$make_script" ] || {
		display_error "$GIT_REF has no src/$make_script"
		rm -rf "$GO_INSTALL_ROOT"
		return 2
	}

	display_message "Building $GIT_REF from the git checkout (log: $log)"
	(
		unset GOROOT GOPATH GOBIN GOOS GOARCH GOFLAGS GO111MODULE
		export GOTOOLCHAIN=local
		[ -n "$bootstrap" ] && export GOROOT_BOOTSTRAP="$bootstrap"
		cd "$GO_INSTALL_ROOT/src" || exit 1
		chmod -f +x "./$make_script"
		"./$make_script" > "$log" 2>&1
	) || {
		display_error "Failed to build $GIT_REF"
		display_message "See $log"
		return 1
	}

	# A checkout does not ship a VERSION file, and its git describe output is
	# not a version string either. Ask the binary that was just built.
	BUILT_VERSION="$("$GO_INSTALL_ROOT/bin/go" env GOVERSION 2> /dev/null)"
	BUILT_VERSION="${BUILT_VERSION#go}"
	if ! gvm_version_is_valid "$BUILT_VERSION"; then
		BUILT_VERSION="${build_version#go}"
	fi
	return 0
}

# The environment file is what `gvm use` sources. Keep the variable set in sync
# with scripts/function/gvm_environment_defaults.
function create_environment() {
	local env_file="$GVM_ROOT/environments/$GO_NAME"

	mkdir -p "$GVM_ROOT/environments" "$GVM_ROOT/pkgsets/$GO_NAME" || return 1

	cat > "$env_file" <<EOF
export GVM_ROOT; GVM_ROOT="$GVM_ROOT"
export gvm_go_name; gvm_go_name="$GO_NAME"
export gvm_pkgset_name; gvm_pkgset_name="global"
export GOROOT; GOROOT="\$GVM_ROOT/gos/$GO_NAME"
export GOPATH; GOPATH="\$GVM_ROOT/pkgsets/$GO_NAME/global"
export GVM_OVERLAY_PREFIX; GVM_OVERLAY_PREFIX="\${GVM_ROOT}/pkgsets/$GO_NAME/global/overlay"
export PATH; PATH="\${GVM_ROOT}/pkgsets/$GO_NAME/global/bin:\${GVM_ROOT}/gos/$GO_NAME/bin:\${GVM_OVERLAY_PREFIX}/bin:\${GVM_ROOT}/bin:\${PATH}"
export LD_LIBRARY_PATH; LD_LIBRARY_PATH="\${GVM_OVERLAY_PREFIX}/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export DYLD_LIBRARY_PATH; DYLD_LIBRARY_PATH="\${GVM_OVERLAY_PREFIX}/lib\${DYLD_LIBRARY_PATH:+:\$DYLD_LIBRARY_PATH}"
# Pin the toolchain: a go.mod asking for a newer Go must not make the selected
# one quietly download and use that instead. See scripts/function/gvm_export_path.
export GOTOOLCHAIN; GOTOOLCHAIN="local"
export PKG_CONFIG_PATH; PKG_CONFIG_PATH="\${GVM_OVERLAY_PREFIX}/lib/pkgconfig:\${PKG_CONFIG_PATH}"
EOF

	# The default pkgset that every install gets.
	mkdir -p "$GVM_ROOT/pkgsets/$GO_NAME/global/overlay/bin" \
		"$GVM_ROOT/pkgsets/$GO_NAME/global/overlay/lib/pkgconfig" || return 1

	cp "$env_file" "$GVM_ROOT/environments/${GO_NAME}@global" || return 1
	cat >> "$GVM_ROOT/environments/${GO_NAME}@global" <<EOF
export GOPATH; GOPATH="\$GOPATH:\$GVM_ROOT/pkgsets/$GO_NAME/global"
export PATH; PATH="\$GVM_ROOT/pkgsets/$GO_NAME/global/bin:\$PATH"
EOF
	return 0
}

function write_manifest() {
	(cd "$GO_INSTALL_ROOT" && find . > manifest) 2> /dev/null
}

function prepare_install_root() {
	GO_INSTALL_ROOT="$GVM_ROOT/gos/$GO_NAME"

	if [ -d "$GO_INSTALL_ROOT" ]; then
		if [ -f "$GO_INSTALL_ROOT/VERSION" ] || [ -x "$GO_INSTALL_ROOT/bin/go" ]; then
			if [ -n "$FORCE" ]; then
				display_warning "Replacing the existing $GO_NAME install"
				# Only what is being replaced is removed. Going through `uninstall`
				# here also ran `go clean -modcache` and deleted the whole pkgset,
				# so reinstalling a version - the way you recover from a corrupted
				# GOROOT - threw away every module in the download cache and
				# everything `go get` had built for it. Aliases still resolve: the
				# version is about to exist again under the same name.
				rm -rf "$GO_INSTALL_ROOT" "$GVM_ROOT/environments/${GO_NAME}"* 2> /dev/null
			else
				display_message "$GO_NAME is already installed"
				return 1
			fi
		else
			display_warning "Removing the incomplete $GO_NAME install"
			rm -rf "$GO_INSTALL_ROOT"
		fi
	fi

	# The environment files describe the install and are rewritten below, so they
	# always go. The pkgset does not: it holds the module cache and everything
	# `go get` built, and deleting it here meant that reinstalling a version -
	# the way you recover from a broken GOROOT - also threw all of that away.
	rm -rf "$GVM_ROOT/environments/${GO_NAME}"* 2> /dev/null
	mkdir -p "$GO_INSTALL_ROOT" || return 1
	trap 'rm -rf "$GO_INSTALL_ROOT"' INT TERM
	return 0
}

function run_install() {
	local rc=0

	case "$INSTALL_METHOD" in
		binary) install_from_binary || rc=$? ;;
		source) install_from_source || rc=$? ;;
		git) install_from_git || rc=$? ;;
		prefer-binary)
			install_from_binary || rc=$?
			[ "$rc" = "0" ] || {
				display_warning "Falling back to a source build of $GO_VERSION"
				rm -rf "$GO_INSTALL_ROOT"
				mkdir -p "$GO_INSTALL_ROOT"
				install_from_source || rc=$?
			}
			;;
		prefer-source)
			install_from_source || rc=$?
			[ "$rc" = "0" ] || {
				display_warning "Falling back to the prebuilt binary of $GO_VERSION"
				rm -rf "$GO_INSTALL_ROOT"
				mkdir -p "$GO_INSTALL_ROOT"
				install_from_binary || rc=$?
			}
			;;
	esac

	[ "$rc" = "0" ] || {
		rm -rf "$GO_INSTALL_ROOT" 2> /dev/null
		return "$rc"
	}

	# Record what is actually installed, then wire up the environment.
	# A binary tarball ships its own VERSION file; a git checkout and a source
	# build both need one written for them, and writing a blank one would make
	# the install look broken to every later command.
	if [ ! -f "$GO_INSTALL_ROOT/VERSION" ]; then
		local recorded="${BUILT_VERSION:-${GO_VERSION#go}}"
		[ -n "$recorded" ] || recorded="$("$GO_INSTALL_ROOT/bin/go" env GOVERSION 2> /dev/null)"
		recorded="${recorded#go}"
		if [ -n "$recorded" ]; then
			echo "$recorded" > "$GO_INSTALL_ROOT/VERSION"
		else
			display_error "Could not determine the version that was built"
			rm -rf "$GO_INSTALL_ROOT" 2> /dev/null
			return 1
		fi
	fi
	BUILT_VERSION=""
	write_manifest
	create_environment || {
		display_error "Failed to create the environment for $GO_NAME"
		return 1
	}

	display_message "$GO_NAME successfully installed"

	if [ -n "$SET_DEFAULT" ]; then
		cp "$GVM_ROOT/environments/$GO_NAME" "$GVM_ROOT/environments/default" &&
			display_message "$GO_NAME is now the default version"
	elif [ -f "$GVM_ROOT/environments/default" ] &&
		grep -q "gvm_go_name; gvm_go_name=\"$GO_NAME\"" "$GVM_ROOT/environments/default" 2> /dev/null; then
		# The default is a copy of some version's environment. When that version
		# is reinstalled, the copy is now older than the original: reinstalling
		# go1.27.0 over an older gvm left `default` without GOTOOLCHAIN, so a new
		# shell quietly lost the pinning that `gvm use` reports.
		cp "$GVM_ROOT/environments/$GO_NAME" "$GVM_ROOT/environments/default" 2> /dev/null &&
			display_message "  refreshed environments/default for $GO_NAME"
	fi
	return 0
}

function main() {
	read_command_line "$@"

	REQUESTED="$GO_VERSION"

	# Resolve before touching the filesystem so a typo fails fast.
	if [ "$INSTALL_METHOD" != "git" ]; then
		local resolved
		if ! resolved="$(gvm_resolve_version "$GO_VERSION" remote)"; then
			display_error "No published Go release matches '$GO_VERSION'"
			display_message "Run 'gvm ls-remote $GO_VERSION' to see what exists."
			return 1
		fi
		GO_VERSION="$resolved"

		# `gvm install 1.28` falls back to a release candidate when Go has not
		# shipped a stable 1.28 yet. That is a reasonable thing to do, but the
		# user has to be told: release candidates are not what most people mean
		# by "the 1.28 toolchain".
		if gvm_version_is_prerelease "$GO_VERSION" && [[ "$GO_VERSION" != *"$REQUESTED"* ]]; then
			display_warning "$GO_VERSION is a pre-release, the newest match for '$REQUESTED'."
			display_message "Install the newest stable release instead with 'gvm install stable'."
		fi
	fi

	[ -n "$GO_NAME" ] || GO_NAME="$GO_VERSION"

	if ! prepare_install_root; then
		return 0
	fi

	run_install
	local rc=$?

	if [ "$rc" = "0" ] && [ -z "$SET_DEFAULT" ]; then
		# Match nvm: installing a version is not the same as selecting it.
		# Make the first install the default so a fresh gvm is usable.
		if [ ! -f "$GVM_ROOT/environments/default" ]; then
			cp "$GVM_ROOT/environments/$GO_NAME" "$GVM_ROOT/environments/default" 2> /dev/null
		fi
	fi

	return "$rc"
}

main "$@"
