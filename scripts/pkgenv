#!/usr/bin/env bash
#
# gvm pkgenv - show or edit the environment of a package set.
#
# The old script opened $EDITOR when given no arguments, which meant `gvm
# pkgenv` in a script or a CI job launched vi and hung. Printing the environment
# is the safe default, the way nvm's `nvm env` does it, and editing has to be
# asked for.

. "$GVM_ROOT/scripts/functions"

function show_usage() {
  echo "Usage: gvm pkgenv [<packageset-name>] [options]"
  echo
  echo "  -o, --output   Write the environment to stdout (the default)."
  echo "  -e, --edit     Open it in \$EDITOR instead."
  echo "  -h, --help     Display this message."
  echo
  echo "The [packageset-name] defaults to the current package set."
  echo
}

gvm_env=""
output=1
edit=""

for i in "$@"; do
  case "$i" in
    -h | --help*)
      show_usage
      exit 0
      ;;
    -o | --output*)
      output=1
      edit=""
      ;;
    -e | --edit*)
      edit=1
      output=""
      ;;
    -*)
      display_error "Unknown option: $i"
      show_usage
      exit 64
      ;;
    *)
      gvm_env="$i"
      ;;
  esac
done

if [ -z "${gvm_go_name:-}" ]; then
  display_message "Run 'gvm use <version>' first"
  display_fatal "current go version not managed by gvm"
fi

if [ -n "$gvm_env" ]; then
  gvm_env="@$gvm_env"
fi

env_file="$GVM_ROOT/environments/$gvm_go_name$gvm_env"

if [ ! -f "$env_file" ]; then
  display_error "No such package set environment: $env_file"
  display_message "Run 'gvm pkgset' to see what exists for $gvm_go_name."
  exit 66
fi

if [ -n "$edit" ]; then
  if [ ! -t 0 ] && [ -z "${EDITOR:-}" ]; then
    display_error "Not a terminal and EDITOR is not set, so there is nothing to edit with."
    display_message "Set EDITOR, or use 'gvm pkgenv --output' to print the environment."
    exit 1
  fi
  ${EDITOR:-vi} "$env_file" || exit $?
  exit 0
fi

cat "$env_file"
