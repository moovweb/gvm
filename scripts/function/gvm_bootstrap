#!/usr/bin/env bash
#
# GOROOT_BOOTSTRAP resolution.
#
# Building Go from source needs a Go toolchain to build with, and the minimum
# acceptable one climbs every few releases. Historically gvm just said
# "export GOROOT_BOOTSTRAP=$(go env GOROOT)" and left the user to discover the
# failure. These values are the `bootgo` floor compiled into each release's
# own src/make.bash, which is stricter and more accurate than the prose in
# go.dev/doc/install/source:
#
#   Go 1.5  - 1.19   needs Go 1.4        (the last C toolchain release)
#   Go 1.20 - 1.21   needs Go 1.17.13
#   Go 1.22 - 1.23   needs Go 1.20.6
#   Go 1.24 - 1.25   needs Go 1.22.6
#   Go 1.26 - 1.27   needs Go 1.24.6
#
# Forward, Go 1.N requires Go 1.(N-2) rounded down to an even number, and
# sometimes with a point-release floor. Anything newer than the table falls
# back to that rule.

# gvm_bootstrap_required <target-version>
# Echoes the minimum bootstrap version, "c" when only a C toolchain is needed
# (Go 1.4 and earlier), or "unknown".
gvm_bootstrap_required() {
	local target="${1:-}" minor
	if ! gvm_version_is_valid "$target"; then
		echo unknown
		return 0
	fi
	minor="$(gvm_version_major_minor "$target")"
	case "$minor" in
		1.0 | 1.1 | 1.2 | 1.3 | 1.4) echo c ;;
		1.5 | 1.6 | 1.7 | 1.8 | 1.9 | 1.10 | 1.11 | 1.12 | 1.13 | 1.14 | 1.15 | 1.16 | 1.17 | 1.18 | 1.19)
			echo go1.4
			;;
		1.20 | 1.21) echo go1.17.13 ;;
		1.22 | 1.23) echo go1.20.6 ;;
		1.24 | 1.25) echo go1.22.6 ;;
		1.26 | 1.27) echo go1.24.6 ;;
		*)
			# Go 1.N needs Go 1.(N-2) rounded down to an even number.
			echo "forward"
			;;
	esac
}

# gvm_bootstrap_floor <target-version>
# Like gvm_bootstrap_required but resolves the "forward" case into a concrete
# version. The point-release floor is deliberately omitted here: we have no
# way to know it, and guessing wrong would block a build that would work.
gvm_bootstrap_floor() {
	local target="${1:-}" required minor major
	required="$(gvm_bootstrap_required "$target")"
	if [ "$required" != "forward" ]; then
		echo "$required"
		return 0
	fi
	minor="$(gvm_version_major_minor "$target")"
	major="${minor#1.}"
	[ "$major" = "$minor" ] && {
		echo unknown
		return 0
	}
	# N-2, rounded down to an even number.
	major=$((major - 2))
	if [ $((major % 2)) -ne 0 ]; then
		major=$((major - 1))
	fi
	[ "$major" -lt 4 ] && {
		echo c
		return 0
	}
	echo "go1.$major"
}

# gvm_go_version_of <goroot>
# Reads <goroot>/VERSION, falling back to asking the binary. Echoes the
# toolchain version, or nothing when this is not a usable Go tree.
gvm_go_version_of() {
	local goroot="${1:-}" version=""
	[ -n "$goroot" ] && [ -d "$goroot" ] || return 1

	if [ -f "$goroot/VERSION" ]; then
		version="$(head -n 1 "$goroot/VERSION" 2> /dev/null)"
	fi
	version="${version#go}"

	if [ -z "$version" ] && [ -x "$goroot/bin/go" ]; then
		version="$("$goroot/bin/go" version 2> /dev/null)"
		version="${version#go version }"
		version="${version%% *}"
		version="${version#go}"
	fi

	gvm_version_is_valid "$version" || return 1
	echo "go$version"
}

# gvm_bootstrap_usable <goroot> <target-version>
# True when <goroot> can build <target-version>.
gvm_bootstrap_usable() {
	local goroot="${1:-}" target="${2:-}" floor have
	floor="$(gvm_bootstrap_floor "$target")"

	[ "$floor" = "c" ] && return 0 # no Go bootstrap needed at all
	[ "$floor" = "unknown" ] && return 1

	# A tree with a VERSION file but no bin/go is not a toolchain. An unpacked
	# source tarball is exactly that, which is how an in-progress install used
	# to get nominated to build itself.
	[ -x "$goroot/bin/go" ] || return 1

	have="$(gvm_go_version_of "$goroot")" || return 1
	gvm_version_is_at_least "$have" "$floor"
}

# gvm_bootstrap_installed_candidates
# Every GOROOT under $GVM_ROOT/gos that can actually be run as a toolchain,
# oldest first. bin/go is required: a directory with only a VERSION file is an
# unpacked source tree, not something you can build with.
gvm_bootstrap_installed_candidates() {
	[ -d "$GVM_ROOT/gos" ] || return 0
	local dir
	for dir in "$GVM_ROOT"/gos/*; do
		[ -d "$dir" ] || continue
		[ -x "$dir/bin/go" ] || continue
		echo "$dir"
	done | __gvm_gorots_by_version
}

# Sort GOROOTs on stdin by the version recorded in their VERSION file.
__gvm_gorots_by_version() {
	while IFS= read -r dir; do
		printf '%s\t%s\n' "$(gvm_version_sort_key "$(gvm_go_version_of "$dir")")" "$dir"
	done | sort | cut -f2-
}

# gvm_bootstrap_checkout_version <checkout-dir>
# Works out which Go release a git checkout is going to become, so that a build
# of `master` can pick a sensible GOROOT_BOOTSTRAP. "master" is not a version
# number, so gvm_bootstrap_required cannot make sense of it directly.
gvm_bootstrap_checkout_version() {
	local dir="${1:-}" raw=""
	[ -d "$dir" ] || return 1

	# The most reliable signal: the nearest tag. git describe gives
	# go1.27.1-0.20260101120000-abcdef012345, and go1.28-beta1 on a release
	# branch.
	if [ -d "$dir/.git" ] && command -v git > /dev/null 2>&1; then
		raw="$(cd "$dir" && git describe --tags --match 'go1.*' 2> /dev/null | head -n 1)"
		raw="${raw%%-[0-9]*-g*}" # drop the -N-gHASH distance suffix
		raw="${raw%%-*}"         # go1.28-beta1 -> go1.28
	fi

	# Newer trees state the version in their own source.
	if [ -z "$raw" ] && [ -f "$dir/src/internal/goversion/goversion.go" ]; then
		raw="$(sed -n 's/.*TheVersion *= *"\(go[0-9][^"]*\)".*/\1/p' \
			"$dir/src/internal/goversion/goversion.go" 2> /dev/null | head -n 1)"
		raw="${raw%%-*}" # go1.28-devel_20260101 -> go1.28
	fi

	if gvm_version_is_valid "$raw"; then
		echo "go${raw#go}"
		return 0
	fi

	# Nothing readable in the tree. The unreleased branch never needs a newer
	# bootstrap than the newest release, so that is a safe assumption.
	local latest
	latest="$(gvm_index_latest_stable 2> /dev/null)"
	if [ -n "$latest" ]; then
		echo "$latest"
		return 0
	fi
	gvm_versions_installed | gvm_versions_latest
}

# gvm_bootstrap_resolve <target-version>
# Echoes a GOROOT that can build <target-version>. Fails with instructions
# when none is available, instead of letting make.bash fail cryptically.
gvm_bootstrap_resolve() {
	local target="${1:-}" floor
	floor="$(gvm_bootstrap_floor "$target")"

	if [ "$floor" = "c" ]; then
		# Go 1.4 and earlier bootstrap themselves from C.
		echo ""
		return 0
	fi
	if [ "$floor" = "unknown" ]; then
		display_error "Don't know what $target needs to bootstrap itself from"
		display_message "Set GOROOT_BOOTSTRAP to a Go >= $target tree and retry."
		return 1
	fi

	# 1. An explicit choice always wins.
	local explicit="${GVM_BOOTSTRAP_GOROOT:-${GOROOT_BOOTSTRAP:-}}"
	if [ -n "$explicit" ]; then
		if gvm_bootstrap_usable "$explicit" "$target"; then
			echo "$explicit"
			return 0
		fi
		display_error "GOROOT_BOOTSTRAP=$explicit cannot build $target"
		display_message "$target needs Go ${floor#go} or later; $explicit is $(gvm_go_version_of "$explicit" || echo unknown)"
		return 1
	fi

	# 2. Anything already installed under GVM_ROOT, preferring the oldest
	#    release that still qualifies: that is the combination upstream tests.
	local candidate
	while IFS= read -r candidate; do
		[ -n "$candidate" ] || continue
		if gvm_bootstrap_usable "$candidate" "$target"; then
			echo "$candidate"
			return 0
		fi
	done <<< "$(gvm_bootstrap_installed_candidates)"

	# 3. A go on PATH, which covers distro packages and GOTOOLCHAIN downloads.
	local path_go path_root
	path_go="$(command -v go 2> /dev/null)"
	if [ -n "$path_go" ]; then
		path_root="$(dirname "$(dirname "$path_go")")"
		if gvm_bootstrap_usable "$path_root" "$target"; then
			echo "$path_root"
			return 0
		fi
	fi

	# 4. The gvm default alias, if it points somewhere usable.
	local default
	default="$(gvm_alias_resolve default 2> /dev/null)"
	if [ -n "$default" ] && [ -d "$GVM_ROOT/gos/$default" ]; then
		if gvm_bootstrap_usable "$GVM_ROOT/gos/$default" "$target"; then
			echo "$GVM_ROOT/gos/$default"
			return 0
		fi
	fi

	# Nothing suitable. Say exactly what to do about it.
	display_error "Building $target from source needs Go ${floor#go} or later, and no usable toolchain was found."
	display_message ""
	display_message "Install one with:"
	display_message "  gvm install $floor"
	display_message ""
	display_message "Or point gvm at an existing tree:"
	display_message "  export GOROOT_BOOTSTRAP=/path/to/go"
	return 1
}

# gvm_bootstrap_explain <target-version>   human readable summary
gvm_bootstrap_explain() {
	local target="${1:-}" floor
	floor="$(gvm_bootstrap_floor "$target")"
	case "$floor" in
		c) echo "$target builds from C; needs gcc, make and bison but no Go bootstrap" ;;
		unknown) echo "unknown bootstrap requirement for $target" ;;
		*) echo "$target needs Go ${floor#go} or later in GOROOT_BOOTSTRAP" ;;
	esac
}
