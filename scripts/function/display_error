#!/usr/bin/env bash
. "$GVM_ROOT/scripts/function/_display_colors"

# display_error <text>
# An error, on stderr so it does not pollute captured stdout. Returns 1, so
# `display_error "..." && ...` and `if display_error ...` behave.
display_error() {
	local color
	color="$(gvm_display_color red)"
	if [ -n "$color" ]; then
		printf '%s%sERROR: %s%s\n' "$color" "$(gvm_display_color reset)" "${1:-}" "$(gvm_display_color reset)" >&2
	else
		printf 'ERROR: %s\n' "${1:-}" >&2
	fi
	return 1
}
