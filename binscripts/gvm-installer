#!/usr/bin/env bash
#
# gvm-installer - the one-liner installer.
#
#   bash <(curl -sSL https://raw.githubusercontent.com/moovweb/gvm/master/binscripts/gvm-installer)
#
# The previous version cloned the repository, renamed .git to git.bak, guessed a
# profile with `finger`, and then overwrote scripts/gvm with two generated lines
# - so the file a user sourced was not the one the project ships, and moving the
# directory broke every shell. All of that now lives in install.sh, which is
# part of the repository. This script only has to fetch it and hand over.

set -u

repo="${GVM_REPO:-https://github.com/moovweb/gvm}"
raw="https://raw.githubusercontent.com/moovweb/gvm"

display_error() {
	printf 'ERROR: %s\n' "$1" >&2
}

display_message() {
	printf '%s\n' "$1"
}

usage() {
	cat <<EOF
Usage: bash <(curl -sSL $raw/master/binscripts/gvm-installer) -- [options]

Downloads install.sh from gvm and runs it. Every option is passed straight
through:

  --prefix <dir>    Where to install. Default: \$HOME/.gvm
  --profile <file>  Profile to update instead of guessing
  --no-profile      Do not touch any profile file
  --force           Install over an existing gvm
  --no-clone        Install from a gvm checkout you already have
  --keep-repo       Keep the git checkout, so 'gvm update' can update gvm
  --uninstall       Remove an installed gvm
  -h, --help        Show install.sh's own help

Environment:
  GVM_REPO          Clone from this URL instead of $repo
EOF
}

# -h/--help and --version are answered here, everything else is forwarded.
args=()
while [ $# -gt 0 ]; do
	case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		--version)
			printf 'gvm installer; run with --help for usage\n'
			exit 0
			;;
		*) args+=("$1") ;;
	esac
	shift
done

command -v bash > /dev/null 2>&1 || {
	display_error "This installer needs bash"
	exit 1
}

tmp="$(mktemp -d "${TMPDIR:-/tmp}/gvm-installer.XXXXXX")" || {
	display_error "Could not create a temporary directory"
	exit 1
}
trap 'rm -rf "$tmp"' EXIT INT TERM

if ! curl -fsSL "$raw/master/install.sh" -o "$tmp/install.sh"; then
	display_error "Could not download install.sh from $raw/master/install.sh"
	display_message ""
	display_message "Download it by hand, or clone and install locally:"
	display_message "  git clone $repo"
	display_message "  cd gvm && ./install.sh --no-clone"
	exit 1
fi

if [ ! -s "$tmp/install.sh" ]; then
	display_error "The downloaded install.sh is empty; that is not a working installer"
	exit 1
fi

bash "$tmp/install.sh" "${args[@]:-}"
