#!/usr/bin/env bash
#
# gvm - the Go Version Manager.
#
# This is the non-interactive entry point. `use` and `pkgset use` have to run
# inside the calling shell to be able to change its environment, so the shell
# function in scripts/env/gvm handles those before handing over to us.

# Before scripts/functions is sourced, so this cannot use gvm_flag_is_set: an
# undefined command here printed "command not found" on every single gvm call
# and left GVM_DEBUG doing nothing. GVM_DEBUG=0 is read as "off" as a courtesy.
case "$(printf '%s' "${GVM_DEBUG:-}" | tr '[:upper:]' '[:lower:]')" in
	1 | true | yes | on | y) set -x ;;
esac

if [ -z "${GVM_ROOT:-}" ]; then
	tput sgr0 2> /dev/null
	tput setaf 1 2> /dev/null
	echo 'ERROR: GVM_ROOT is not set. Add this line to your shell profile:' >&2
	echo >&2
	echo '    [[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm"' >&2
	echo >&2
	echo 'Or install gvm with:' >&2
	echo '    bash <(curl -sSL https://raw.githubusercontent.com/moovweb/gvm/master/binscripts/gvm-installer)' >&2
	tput sgr0 2> /dev/null
	exit 1
fi

command="${1:-}"

# implode has to work even when the rest of gvm is broken, which is exactly
# when somebody reaches for it, so it must not depend on scripts/functions
# being readable. Fall back to plain echo if it is not.
if [ "$command" = "implode" ]; then
	if [ -r "$GVM_ROOT/scripts/functions" ]; then
		. "$GVM_ROOT/scripts/functions"
	else
		display_message() { echo "$*"; }
		display_error() { echo "ERROR: $*" >&2; }
		display_warning() { echo "WARNING: $*" >&2; }
	fi
	. "$GVM_ROOT/scripts/env/implode"
	shift
	gvm_implode "$@"
	exit $?
fi

if ! . "$GVM_ROOT/scripts/functions"; then
	display_error "GVM_ROOT/scripts/functions is missing or unreadable."
	display_error "Run 'gvm doctor' for details, or reinstall GVM."
	exit 1
fi

"$GVM_ROOT/scripts/gvm-check"
if [ "$?" != "0" ]; then
	display_fatal "Missing requirements. Run 'gvm doctor' for details."
	exit 1
fi

# A few names that are not files on disk. No arguments at all prints help,
# the way nvm does, so that a bare `gvm` never looks like it hung.
case "$command" in
	"" | -h | --help | help)
		exec "$GVM_ROOT/scripts/help"
		;;
	-v | --version | version)
		exec "$GVM_ROOT/scripts/version"
		;;
esac

if [ -x "$GVM_ROOT/scripts/$command" ]; then
	shift
	exec "$GVM_ROOT/scripts/$command" "$@"
fi

display_fatal "Unrecognized command: '$command'. Run 'gvm help' for a list."
